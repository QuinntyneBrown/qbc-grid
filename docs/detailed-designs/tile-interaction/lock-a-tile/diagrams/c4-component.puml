@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components - Lock a tile

Container_Boundary(components, "src/qbc-grid") {
  Component(grid, "GridComponent", "Angular standalone component", "Tests locked before starting any gesture and before setting a tab index")
  Component(tile, "GridTile", "TypeScript type", "Carries the optional locked flag")
  Component(session, "GridPointerSession", "TypeScript class", "Never receives a start call for a locked tile")
  Component(keys, "gridKeyboardCandidate", "TypeScript function", "Never receives a key event whose tile is locked")
  Component(canplace, "canPlace", "TypeScript function", "Counts a locked tile as occupied like any other")
  Component(styles, "grid.css", "Component stylesheet", "Suppresses the handle and cursor on a locked tile")
}

Container_Ext(app, "src/e2e-app", "Angular application", "Supplies the locked flag in the layout")

Rel(app, grid, "Binds a layout carrying locked to")
Rel(grid, tile, "Reads locked from")
Rel(grid, session, "Starts a gesture only for an unlocked tile through")
Rel(grid, keys, "Dispatches key events for an unlocked tile to")
Rel(grid, canplace, "Tests targets with")
Rel(grid, styles, "Sets the data-locked attribute read by")
@enduml
