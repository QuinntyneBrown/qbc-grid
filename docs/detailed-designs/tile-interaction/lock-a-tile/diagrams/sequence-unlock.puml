@startuml
title UML sequence behaviour - Unlock a tile
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Dashboard operator" as actor
box "Application - e2e-app" #E0F2FE
  participant "DashboardPage" as page
end box
box "Library - src/qbc-grid" #ECFDF3
  participant "GridComponent" as grid
  participant "grid.css" as styles
end box
box "Platform - desktop browser" #FFF4E5
  participant "DOM and compositor" as dom
end box

actor -> page : Toggle the lock on one tile
page -> page : Set locked to false for that id
page -> grid : Bind the updated layout
grid -> grid : Recompute isInteractive for that tile only
grid -> dom : Set tabindex 0 on the tile per L2-008
grid -> dom : Clear the data-locked attribute
styles -> dom : Reveal the resize handle and the move cursor
dom --> actor : Present the tile as draggable, with no reload
actor -> dom : Press and drag the tile
dom -> grid : pointerdown, then pointermove past the threshold
grid --> actor : Begin the drag normally
@enduml
