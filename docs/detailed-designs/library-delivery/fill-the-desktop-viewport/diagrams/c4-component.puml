@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components - Fill the desktop viewport

Container_Boundary(components, "components library") {
  Component(grid, "GridComponent", "Angular standalone component", "Publishes GridMetrics and writes the grid custom properties")
  Component(observer, "GridWidthObserver", "TypeScript class", "Wraps ResizeObserver on the grid host and reports the content width")
  Component(metrics, "GridMetrics", "TypeScript type", "columns, columnWidth, rowHeight, and gap")
  Component(styles, "grid.css", "Component stylesheet", "Derives every tile rectangle with calc from the custom properties")
}

Container_Ext(domain, "domain library", "Angular library", "Places the grid in a container of its own choosing")
System_Ext(browser, "Desktop browser", "ResizeObserver, layout, and the compositor")

Rel(domain, grid, "Sizes the container of")
Rel(grid, observer, "Observes its host through")
Rel(observer, browser, "Subscribes to", "ResizeObserver")
Rel(browser, observer, "Reports content box width changes to")
Rel(observer, grid, "Reports the content width to")
Rel(grid, metrics, "Recomputes columnWidth in")
Rel(metrics, styles, "Sets the custom properties read by")
Rel(styles, browser, "Repositions every tile in", "DOM")
@enduml
