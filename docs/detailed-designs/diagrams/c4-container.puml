@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers - qbc-grid dashboard

Person(operator, "Dashboard operator", "Arranges and watches telemetry tiles")

System_Boundary(system, "qbc-grid repository") {
  Container(lib, "src/qbc-grid", "Angular library, published to npm", "GridComponent, the tile template directive, and the pure layout core")
  Container(e2eapp, "src/e2e-app", "Angular application", "Routed dashboard page, mode toggle, layout persistence, fixtures, and the attributes page objects hold")
  Container(devapp, "src/dev-app", "Angular application", "Manual harness for working on the library by hand")
  Container(tokens, "design-system", "Static site and CSS package", "Authoritative qbc design tokens")
}

System_Ext(browser, "Desktop browser", "Pointer, keyboard, ResizeObserver, and the compositor")
ContainerDb_Ext(store, "Layout store", "Browser local storage", "Persists the last settled layout")

Rel(operator, e2eapp, "Uses", "Pointer and keyboard")
Rel(e2eapp, lib, "Renders, and persists what it emits")
Rel(devapp, lib, "Renders")
Rel(e2eapp, store, "Reads and writes through DASHBOARD_SERVICE", "JSON")
Rel(lib, tokens, "Reads", "CSS custom properties")
Rel(lib, browser, "Listens to and paints through", "DOM")
@enduml
